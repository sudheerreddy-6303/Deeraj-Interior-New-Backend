# Copy this file to .env and fill in your values
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deeraj_interiors

# Long random string used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

# First admin account (created by `npm run db:setup`)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@deerajinteriors.com
ADMIN_PASSWORD=ChangeMe@123

# Frontend URL allowed to call the API (comma-separate several)
CLIENT_URL=http://localhost:5173

# Public URL of this API, used to build links to uploaded photos/videos (leave empty to use relative /uploads paths)
PUBLIC_URL=

# Visitor counter: dashboard dates use this time zone offset in minutes (330 = India, UTC+5:30)
TZ_OFFSET_MINUTES=330

# Razorpay online payments (from dashboard.razorpay.com → Account & Settings → API Keys / Webhooks).
# Use rzp_test_… keys while testing and rzp_live_… keys to take real payments. Never share the secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
